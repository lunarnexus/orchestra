#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import select
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, NoReturn, cast

try:
    import yaml
except ModuleNotFoundError as exc:  # pragma: no cover - environment issue
    raise SystemExit("PyYAML is required to run this smoke script") from exc

DEFAULT_TASK = "return exactly: pi smoke done"
RUN_ID_RE = re.compile(r"\borchestra dispatched:\s+\S+\s+([A-Za-z0-9._:-]+)\b")
PREFLIGHT_MAIN_SESSION_ID = "orch-spsi-preflight-main"
PREFLIGHT_SKILL_FILENAME = "SKILL.md"
PREFLIGHT_MISSING_SKILL = "orch-spsi-preflight-missing-skill"
PREFLIGHT_ROLES = ("orchestrator", "builder")
SPSI_SKILL_BLOCK_RE = re.compile(
    r'<orchestra_spsi_skill name="([^"]+)">\nSkill directory: (.+)\n'
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="smoke-pi-live",
        description="Run the live Pi smoke flow for Orchestra.",
    )
    parser.add_argument(
        "--repo-root",
        default=Path(__file__).resolve().parents[1],
        type=Path,
        help="Path to the Orchestra repository root.",
    )
    parser.add_argument(
        "--session-id",
        default=f"orch-smoke-{int(time.time())}",
        help="Pi session id to use for the smoke run.",
    )
    parser.add_argument(
        "--task-label",
        default="smoke-pi-live",
        help="Task label recorded for the /orch do run.",
    )
    parser.add_argument(
        "--goal",
        default=DEFAULT_TASK,
        help="Goal passed to /orch do.",
    )
    parser.add_argument(
        "--wait-seconds",
        default=300,
        type=int,
        help="Seconds to wait for the returned Orchestra prompt in the Pi RPC session.",
    )
    parser.add_argument(
        "--check-args",
        action="store_true",
        help="Validate arguments and exit without running Pi.",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    repo_root = args.repo_root.resolve()
    if args.check_args:
        print(f"smoke args ok: session_id={args.session_id} task_label={args.task_label}")
        return 0

    orchestra = shutil.which("orchestra")
    pi = shutil.which("pi")
    if orchestra is None:
        raise SystemExit("missing prerequisite: orchestra CLI not found in PATH")
    if pi is None:
        raise SystemExit("missing prerequisite: pi CLI not found in PATH")

    _spsi_preflight(orchestra)

    env = os.environ.copy()
    env.setdefault("PYTHONUNBUFFERED", "1")
    env["ORCHESTRA_DISPATCH_BUDGET"] = "0"

    _run([orchestra, "init", "pi", "--force"], env=env, cwd=repo_root)

    pi_session = args.session_id
    rpc = _start_pi_rpc(pi, pi_session, env, repo_root)
    try:
        _send_pi_rpc_prompt(rpc, "/orch help")
        _send_pi_rpc_prompt(rpc, "/orch doctor")
        _send_pi_rpc_prompt(rpc, "/orch roles")
        do_output = _send_pi_rpc_prompt(
            rpc,
            f'/orch do --role builder --task-label "{args.task_label}" {args.goal}',
            wait_for_return_prompt=True,
            wait_seconds=args.wait_seconds,
        )
    finally:
        _stop_process(rpc)

    if "subagent will auto-return when finished" not in do_output:
        raise SystemExit("/orch do did not report that auto-return was armed")
    if not _output_shows_follow_up_delivery(do_output, args.task_label):
        raise SystemExit("Pi RPC stream did not show the injected follow-up return prompt")
    run_id = _extract_run_id(do_output)
    if run_id is None:
        raise SystemExit("could not find a dispatch run id in /orch do output")

    history_output = _poll_history(pi, pi_session, env, repo_root, run_id, args.task_label)
    if run_id not in history_output:
        raise SystemExit("history did not include the builder run id")
    if args.task_label not in history_output:
        raise SystemExit("history did not include the smoke task label")

    config_path = _resolve_config_path(repo_root)
    config = yaml.safe_load(config_path.read_text(encoding="utf-8"))
    state_dir = _resolve_configured_path(repo_root, str(config["state_dir"]))
    db_path = state_dir / "orchestra.db"
    _assert_canonical_return(state_dir, run_id)
    _assert_no_return_artifact(state_dir, run_id)

    auto_verify = bool(config.get("auto_verify"))
    if auto_verify:
        verifier_run_id = _assert_linked_verifier(db_path, state_dir, run_id)
        if verifier_run_id not in history_output:
            raise SystemExit("history did not include the linked verifier run id")
        _assert_no_return_artifact(state_dir, verifier_run_id)

    print(f"smoke ok: {run_id}")
    return 0


def _start_pi_rpc(
    pi: str, session_id: str, env: dict[str, str], cwd: Path
) -> subprocess.Popen[str]:
    return subprocess.Popen(
        [pi, "--mode", "rpc", "--no-approve", "--session-id", session_id],
        env=env,
        cwd=cwd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def _send_pi_rpc_prompt(
    proc: subprocess.Popen[str],
    prompt: str,
    *,
    wait_for_return_prompt: bool = False,
    wait_seconds: int = 30,
) -> str:
    if proc.stdin is None or proc.stdout is None or proc.stderr is None:
        raise SystemExit("pi rpc process streams are unavailable")
    proc.stdin.write(json.dumps({"type": "prompt", "message": prompt}) + "\n")
    proc.stdin.flush()
    deadline = time.time() + (wait_seconds if wait_for_return_prompt else 30)
    lines: list[str] = []
    streams = [proc.stdout, proc.stderr]
    while time.time() < deadline:
        readable, _, _ = select.select(streams, [], [], 0.5)
        if not readable:
            if proc.poll() is not None:
                break
            continue
        for stream in readable:
            line = stream.readline()
            if not line:
                continue
            lines.append(line)
        joined = "".join(lines)
        if wait_for_return_prompt:
            if _output_shows_follow_up_delivery(joined, prompt):
                return joined
        elif '"success":true' in joined or '"success":false' in joined:
            return joined
    return "".join(lines)


def _stop_process(proc: subprocess.Popen[str]) -> None:
    if proc.stdin is not None:
        proc.stdin.close()
    try:
        proc.terminate()
        proc.wait(timeout=5)
    except Exception:
        proc.kill()
        proc.wait(timeout=5)


def _run_pi(
    pi: str,
    session_id: str,
    prompt: str,
    env: dict[str, str],
    cwd: Path,
) -> subprocess.CompletedProcess[str]:
    return _run([pi, "--no-approve", "--session-id", session_id, "-p", prompt], env=env, cwd=cwd)


def _run(command: list[str], *, env: dict[str, str], cwd: Path) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, env=env, cwd=cwd, capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(
            "command failed "
            f"({result.returncode}): {' '.join(command)}\nSTDOUT:\n{result.stdout}\n"
            f"STDERR:\n{result.stderr}"
        )
    return result


def _extract_run_id(output: str) -> str | None:
    match = RUN_ID_RE.search(output)
    return match.group(1) if match else None


def _poll_history(
    pi: str,
    session_id: str,
    env: dict[str, str],
    cwd: Path,
    run_id: str,
    task_label: str,
) -> str:
    last_output = ""
    for _ in range(20):
        result = _run_pi(pi, session_id, "/orch history 10", env, cwd)
        last_output = result.stdout + "\n" + result.stderr
        if run_id in last_output and task_label in last_output and _history_shows_done(last_output):
            return last_output
        time.sleep(0.5)
    raise SystemExit(f"history did not show completed run {run_id} after polling")


def _resolve_config_path(repo_root: Path) -> Path:
    # Match how the orchestra CLI itself resolves the runtime config so the smoke
    # reads the same config the live dispatch uses. ``ORCHESTRA_CONFIG`` is treated
    # as a directory by core (its ``config.yaml`` is the config file).
    from orchestra.config import resolve_config_path as core_resolve_config_path

    resolved = core_resolve_config_path(None)
    if not resolved.exists():
        raise SystemExit(f"could not locate config.yaml via core resolver: {resolved}")
    return resolved


def _preflight_fail(message: str) -> NoReturn:
    raise SystemExit(message)


def _spsi_preflight(orchestra: str) -> None:
    """Deterministic core SPSI preflight from an unrelated cwd with copied config.

    Exercises the real core ``_spsi-payload`` through the same resolved ``orchestra``
    console entrypoint the live Pi host invokes, for every preflight role, and proves
    the payload embeds each catalog-listed skill's actual content and absolute
    resource directory, not just ``enabled: true``. Also proves a configured skill
    that does not resolve fails clearly. No dispatch, LLM, providers, or global init.
    """

    _spsi_preflight_check_install(orchestra)
    base = Path(tempfile.mkdtemp(prefix="orch-spsi-preflight-"))
    try:
        work = base / "work"
        work.mkdir()
        state = base / "state"
        config_dir = base / "config"
        catalog = _spsi_preflight_copy_config(config_dir, state)

        proc = _spsi_preflight_payload(orchestra, work, config_dir, PREFLIGHT_MAIN_SESSION_ID)
        _spsi_preflight_assert_role(proc, catalog, "orchestrator")

        run_id = _spsi_preflight_seed_worker_run(state, "builder", PREFLIGHT_MAIN_SESSION_ID)
        proc = _spsi_preflight_payload(orchestra, work, config_dir, f"orchestra-worker-{run_id}")
        _spsi_preflight_assert_role(proc, catalog, "builder")

        _spsi_preflight_assert_missing_skill(base, work, config_dir, catalog, orchestra)
    finally:
        shutil.rmtree(base, ignore_errors=True)


def _spsi_preflight_check_install(orchestra: str) -> None:
    """Fail fast when the live console entrypoint is a different core install.

    The preflight seeds copied config/state and asserts skill content from this
    script's in-process ``orchestra`` import while the payload runs through the
    resolved ``orchestra`` console entrypoint the live host invokes. If those two
    installs differ, the preflight would validate a core the live host never runs,
    so detect the mismatch and fail loudly rather than silently proving another
    install.
    """

    import orchestra as live_orchestra

    entry = Path(orchestra)
    try:
        first_line = entry.read_text(encoding="utf-8").splitlines()[0]
    except (OSError, IndexError):
        first_line = ""
    tokens = first_line[2:].split() if first_line.startswith("#!") else []
    if tokens and tokens[0].endswith("/env"):
        tokens = tokens[1:]
    if not tokens:
        tokens = [sys.executable]
    result = subprocess.run(
        [*tokens, "-c", "import orchestra; print(orchestra.__file__)"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        _preflight_fail(
            f"could not resolve core install for orchestra entrypoint {orchestra!r}:\n"
            f"STDOUT:\n{result.stdout}\nSTDERR:\n{result.stderr}"
        )
    entry_module = Path(result.stdout.strip()).resolve()
    script_module = Path(live_orchestra.__file__).resolve()
    if entry_module != script_module:
        _preflight_fail(
            "orchestra console entrypoint runs a different core install than this "
            f"script would validate against: entrypoint={entry_module} "
            f"script={script_module}"
        )


def _spsi_preflight_copy_config(config_dir: Path, state_dir: Path) -> dict[str, Any]:
    from orchestra.config import (
        resolve_agent_catalog_path,
        resolve_config_path,
        resolve_prompts_path,
    )

    config_dir.mkdir(parents=True, exist_ok=True)
    data = yaml.safe_load(resolve_config_path(None).read_text(encoding="utf-8"))
    data["state_dir"] = str(state_dir)
    data["mode"] = "orchestrate"
    data["auto_verify"] = False
    (config_dir / "config.yaml").write_text(yaml.safe_dump(data), encoding="utf-8")
    shutil.copy(resolve_prompts_path(None), config_dir / "prompts.yaml")
    shutil.copy(resolve_agent_catalog_path(None), config_dir / "agent-catalog.yaml")
    catalog = yaml.safe_load((config_dir / "agent-catalog.yaml").read_text(encoding="utf-8"))
    return cast(dict[str, Any], catalog)


def _spsi_preflight_seed_worker_run(
    state_dir: Path,
    role: str,
    orchestrator_session_id: str,
) -> str:
    from orchestra.state import RunRecord, StateStore

    run_id = f"preflight{role}{os.getpid()}"
    state_dir.mkdir(parents=True, exist_ok=True)
    store = StateStore(state_dir / "orchestra.db")
    store.initialize()
    store.create_run(
        RunRecord(
            run_id=run_id,
            orchestrator_session_id=orchestrator_session_id,
            harness="pi",
            role=role,
            task_label="spsi-preflight",
            log_path=state_dir / f"{run_id}.log",
            created_at=datetime.datetime.now().isoformat(),
        )
    )
    return run_id


def _spsi_preflight_payload(
    orchestra: str,
    work_dir: Path,
    config_dir: Path,
    session_id: str,
) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["ORCHESTRA_CONFIG"] = str(config_dir)
    env.setdefault("PYTHONUNBUFFERED", "1")
    env.pop("ORCHESTRA_DISPATCH_BUDGET", None)
    return subprocess.run(
        [
            orchestra,
            "_spsi-payload",
            "--session-id",
            session_id,
            "--json",
        ],
        env=env,
        cwd=work_dir,
        capture_output=True,
        text=True,
    )


def _spsi_preflight_assert_role(
    proc: subprocess.CompletedProcess[str],
    catalog: dict[str, Any],
    role_name: str,
) -> None:
    if proc.returncode != 0:
        _preflight_fail(
            f"spsi preflight failed for role '{role_name}' (exit {proc.returncode}):\n"
            f"STDOUT:\n{proc.stdout}\nSTDERR:\n{proc.stderr}"
        )
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        _preflight_fail(f"spsi preflight returned non-json for role '{role_name}': {exc}")
    _spsi_preflight_assert_coverage(payload, catalog, role_name)


def _spsi_preflight_assert_coverage(
    payload: object,
    catalog: dict[str, Any],
    role_name: str,
) -> None:
    if not isinstance(payload, dict):
        _preflight_fail(f"spsi preflight payload for role '{role_name}' is not an object")
    if not payload.get("enabled"):
        _preflight_fail(f"spsi preflight disabled for role '{role_name}'")
    if payload.get("role") != role_name:
        _preflight_fail(
            f"spsi preflight role mismatch: expected '{role_name}', got {payload.get('role')!r}"
        )
    content = payload.get("content")
    if not isinstance(content, str) or not content.strip():
        _preflight_fail(f"spsi preflight payload for role '{role_name}' has no content")
    skills = list(_spsi_preflight_role_skills(catalog, role_name))
    directories = dict(SPSI_SKILL_BLOCK_RE.findall(content))
    if set(directories) != set(skills):
        _preflight_fail(
            f"spsi preflight skill set for role '{role_name}' does not match the catalog: "
            f"payload={sorted(directories)} catalog={sorted(skills)}"
        )
    for skill in skills:
        skill_dir = Path(directories[skill])
        if not skill_dir.is_absolute():
            _preflight_fail(
                f"spsi preflight resource directory for skill '{skill}' "
                f"is not absolute: {skill_dir}"
            )
        skill_md = skill_dir / PREFLIGHT_SKILL_FILENAME
        if not skill_md.is_file():
            _preflight_fail(
                f"spsi preflight skill '{skill}' resource directory has no readable "
                f"{PREFLIGHT_SKILL_FILENAME}: {skill_dir}"
            )
        text = skill_md.read_text(encoding="utf-8").strip()
        if not text or text not in content:
            _preflight_fail(
                f"spsi preflight payload for role '{role_name}' is missing actual content for "
                f"skill '{skill}'"
            )


def _spsi_preflight_role_skills(catalog: dict[str, Any], role_name: str) -> tuple[str, ...]:
    roles = catalog.get("roles")
    role = roles.get(role_name) if isinstance(roles, dict) else None
    skills = role.get("skills") if isinstance(role, dict) else None
    if not isinstance(skills, list) or not skills:
        _preflight_fail(f"catalog role '{role_name}' has no configured skills for preflight")
    return tuple(str(name) for name in skills)


def _spsi_preflight_assert_missing_skill(
    base: Path,
    work: Path,
    config_dir: Path,
    catalog: dict[str, Any],
    orchestra: str,
) -> None:
    check_dir = base / "check-config"
    check_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy(config_dir / "config.yaml", check_dir / "config.yaml")
    shutil.copy(config_dir / "prompts.yaml", check_dir / "prompts.yaml")
    check_catalog = yaml.safe_load((config_dir / "agent-catalog.yaml").read_text(encoding="utf-8"))
    orchestrator = check_catalog.setdefault("roles", {}).setdefault("orchestrator", {})
    existing = list(orchestrator.get("skills") or [])
    orchestrator["skills"] = [*existing, PREFLIGHT_MISSING_SKILL]
    (check_dir / "agent-catalog.yaml").write_text(yaml.safe_dump(check_catalog), encoding="utf-8")

    proc = _spsi_preflight_payload(orchestra, work, check_dir, PREFLIGHT_MAIN_SESSION_ID)
    combined = proc.stdout + proc.stderr
    if proc.returncode == 0:
        _preflight_fail("spsi preflight expected a missing configured skill to fail but it passed")
    if PREFLIGHT_MISSING_SKILL not in combined:
        _preflight_fail(
            "spsi preflight missing-skill failure did not name the missing skill:\n" + combined
        )


def _resolve_configured_path(repo_root: Path, value: str) -> Path:
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = repo_root / path
    return path.resolve()


def _assert_canonical_return(state_dir: Path, run_id: str) -> None:
    artifact = state_dir / "runs" / run_id / "return.md"
    if not artifact.exists():
        raise SystemExit(f"canonical return artifact not found: {artifact}")
    if not artifact.read_text(encoding="utf-8").strip():
        raise SystemExit(f"canonical return artifact is empty: {artifact}")


def _assert_no_return_artifact(state_dir: Path, run_id: str) -> None:
    artifact = state_dir / "return-artifacts" / f"{run_id}.md"
    if artifact.exists():
        raise SystemExit(f"unexpected return artifact created: {artifact}")


def _parse_jsonl_events(output: str) -> list[dict[str, object]]:
    events: list[dict[str, object]] = []
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            parsed = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(parsed, dict):
            events.append(parsed)
    return events


def _output_shows_follow_up_delivery(output: str, _task_label: str) -> bool:
    for event in _parse_jsonl_events(output):
        entry = event.get("entry")
        if isinstance(entry, dict) and entry.get("customType") == "orchestra-output":
            data = entry.get("data")
            if isinstance(data, dict) and "subagent will auto-return when finished" in str(data.get("text", "")):
                continue
        message = event.get("message")
        if isinstance(message, dict) and message.get("role") == "user":
            if "[orchestra:" in json.dumps(message):
                return True
    return False


def _assert_linked_verifier(db_path: Path, state_dir: Path, builder_run_id: str) -> str:
    with sqlite3.connect(db_path) as conn:
        row = conn.execute(
            """
            select run_id, status
            from runs
            where triggered_by_run_id = ? and role = 'verifier'
            order by created_at desc
            limit 1
            """,
            (builder_run_id,),
        ).fetchone()
    if row is None:
        raise SystemExit("auto_verify is enabled but no linked verifier run was stored")
    run_id, status = row
    if status != "done":
        raise SystemExit(f"linked verifier {run_id} did not complete successfully: {status}")
    _assert_canonical_return(state_dir, str(run_id))
    return str(run_id)


def _history_shows_done(output: str) -> bool:
    return "[done]" in output or "status: done" in output


if __name__ == "__main__":
    raise SystemExit(main())
