#!/usr/bin/env python3
"""Enable or disable pass_parent_context for every enabled or auto role.

Usage:
  ./set-enabled-role-parent-context on|off|true|false|1|0

Updates agent-catalog.yaml in the repository root. Roles with enabled: false are
left unchanged. Roles with enabled omitted, enabled: true, or enabled: auto are
updated.
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

_TRUE_VALUES = {"1", "on", "true", "yes", "enable", "enabled"}
_FALSE_VALUES = {"0", "off", "false", "no", "disable", "disabled"}


def _repo_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        script_path = Path(__file__).resolve()
        for candidate in (script_path.parent, *script_path.parents):
            if (candidate / "agent-catalog.yaml").is_file():
                return candidate
        raise SystemExit("could not find repository root containing agent-catalog.yaml") from None

    root = Path(result.stdout.strip())
    if not (root / "agent-catalog.yaml").is_file():
        raise SystemExit(f"agent-catalog.yaml not found in repository root: {root}")
    return root


def _catalog_path() -> Path:
    return _repo_root() / "agent-catalog.yaml"


def _parse_bool(raw: str) -> bool:
    value = raw.strip().lower()
    if value in _TRUE_VALUES:
        return True
    if value in _FALSE_VALUES:
        return False
    raise SystemExit("usage: set-enabled-role-parent-context on|off|true|false|1|0")


def _role_is_enabled(chunk: str) -> bool:
    try:
        loaded = yaml.safe_load(chunk)
    except yaml.YAMLError as exc:
        raise SystemExit(f"could not parse role YAML: {exc}") from exc
    if not isinstance(loaded, dict) or len(loaded) != 1:
        return False
    role_data = next(iter(loaded.values()))
    if not isinstance(role_data, dict):
        return False
    # Orchestrator-only/catalog metadata roles do not launch a child harness and
    # do not support pass_parent_context. Match set-enabled-role-models behavior:
    # only role entries with an actual model line are configurable here.
    if "model" not in role_data:
        return False
    enabled: Any = role_data.get("enabled", True)
    return enabled is True or (isinstance(enabled, str) and enabled.strip().lower() == "auto")


def _split_role_chunks(text: str) -> tuple[str, list[str]]:
    marker = "roles:\n"
    if marker not in text:
        raise SystemExit("agent-catalog.yaml does not contain a roles: section")

    head, roles_body = text.split(marker, 1)
    chunks: list[str] = []
    current: list[str] = [marker]

    for line in roles_body.splitlines(True):
        is_role_header = (
            line.startswith("  ")
            and not line.startswith("    ")
            and line.strip().endswith(":")
        )
        if is_role_header and current:
            chunks.append("".join(current))
            current = []
        current.append(line)
    if current:
        chunks.append("".join(current))
    return head, chunks


def _set_parent_context_in_chunk(chunk: str, enabled: bool) -> tuple[str, bool]:
    value = "true" if enabled else "false"
    new_chunk, count = re.subn(
        r"(^    pass_parent_context: ).*$",
        rf"\g<1>{value}",
        chunk,
        count=1,
        flags=re.MULTILINE,
    )
    if count:
        return new_chunk, new_chunk != chunk

    # Insert after the model line when present, otherwise after the role header.
    lines = chunk.splitlines(True)
    insert_at = 1 if len(lines) > 1 else len(lines)
    for index, line in enumerate(lines):
        if re.match(r"^    model: ", line):
            insert_at = index + 1
            break
    lines.insert(insert_at, f"    pass_parent_context: {value}\n")
    return "".join(lines), True


def _set_enabled_role_parent_context(text: str, enabled: bool) -> tuple[str, int]:
    head, chunks = _split_role_chunks(text)
    changed = 0
    out: list[str] = []

    for chunk in chunks:
        if chunk == "roles:\n" or not _role_is_enabled(chunk):
            out.append(chunk)
            continue
        chunk, did_change = _set_parent_context_in_chunk(chunk, enabled)
        if did_change:
            changed += 1
        out.append(chunk)

    return head + "".join(out), changed


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1].startswith("-"):
        print("usage: set-enabled-role-parent-context on|off|true|false|1|0", file=sys.stderr)
        return 2

    enabled = _parse_bool(sys.argv[1])
    catalog = _catalog_path()
    text = catalog.read_text(encoding="utf-8")
    new_text, changed = _set_enabled_role_parent_context(text, enabled)
    if changed == 0:
        print(f"no enabled role pass_parent_context lines changed in {catalog}")
        return 0
    catalog.write_text(new_text, encoding="utf-8")
    print(f"updated {changed} enabled role pass_parent_context setting(s) in {catalog}")
    print(f"pass_parent_context: {'true' if enabled else 'false'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
