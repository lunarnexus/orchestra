default_role: intern
model_limits:
  lmstudio/llmfan46/qwen3.6-35b-a3b-uncensored-heretic-native-mtp-preserved:
    concurrency: 2
  lmstudio/llmfan46/qwen3.6-27b-uncensored-heretic-v2-native-mtp-preserved:
    concurrency: 2
  lmstudio/qwen/qwen3.8-27b:
    concurrency: 2
  lmstudio/LOADED:
    concurrency: 2
harness_configs:
  pi:
    harness: pi
    command:
    - pi
    - --model
    - '{model}'
    - -p
    - '{prompt}'
  hermes:
    harness: hermes
    command:
    - hermes
    - --profile
    - '{profile}'
    - -z
    - '{prompt}'
  opencode:
    harness: opencode
    command:
    - opencode
    - run
    - --agent
    - '{agent}'
    - --model
    - '{model}'
    - '{prompt}'
roles:
  builder:
    harness_config: pi
    model: lmstudio/LOADED
    skills:
    - builder
    dispatch_hint: Implement the assigned task only. Stay in scope. Run focused
      implementation commands. Update only assigned artifact sections. Return the
      compact schema only.
    enabled: true
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
  verifier:
    harness_config: pi
    model: lmstudio/LOADED
    skills:
    - verifier
    dispatch_hint: Independently prove whether the work satisfies its scope and
      acceptance criteria using fresh evidence. Stay read-only. Return verdict, evidence,
      missing checks, blockers, and risks. Do not write role-owned `.md` artifacts by default.
    enabled: auto
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
  reviewer:
    harness_config: pi
    model: lmstudio/LOADED
    skills:
    - reviewer
    dispatch_hint: Independently review whether the change is correct, maintainable,
      appropriately scoped, and ready to merge. Stay read-only for source code. Run
      no test commands. Return the compact schema only.
    enabled: true
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
  researcher:
    harness_config: pi
    model: lmstudio/LOADED
    dispatch_hint: Gather evidence with sources from docs, web, or code. Do not
      change code. Update only the explicitly assigned RESEARCH.md section when requested. Return
      the compact schema only.
    enabled: true
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
    skills:
    - researcher
  intern:
    harness_config: pi
    model: lmstudio/LOADED
    dispatch_hint: Focus on the assigned task and return a compact result.
    enabled: true
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
  appsec:
    harness_config: pi
    model: lmstudio/LOADED
    skills:
    - appsec
    dispatch_hint: Independently identify realistic vulnerabilities across changed
      trust boundaries. Stay read-only for source code. Return the compact schema only.
    enabled: true
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
  planner:
    harness_config: pi
    model: openai-codex/gpt-5.5
    skills:
    - planner
    dispatch_hint: Plan the work. Ask numbered questions for unknowns. May dispatch
      researchers for facts, docs, web, and code evidence. Return concise plan findings
      and open questions.
    enabled: false
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
    nested_dispatch_depth: 2
  critic:
    harness_config: hermes
    profile: mina
    dispatch_hint: Focus on the assigned task and return a compact result.
    enabled: false
    env:
      HINDSIGHT4PI_AUTO_RETAIN: '0'
      HINDSIGHT4PI_AUTO_RECALL: '0'
