        </mxCell>
        <mxCell id="final" value="_finalize_run(): write return.md and update RunRecord fields" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1320" y="820" width="360" height="90" as="geometry"/>
