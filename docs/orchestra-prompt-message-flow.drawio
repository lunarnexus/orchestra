  <diagram name="10 Error Text Inventory">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Actual error/status message strings and where they cross scopes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="dispatch" value="&lt;b&gt;Dispatch/tool-call errors&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;Usage: provide a worker goal.&#10;context.sessionID is required for orch_dispatch.&#10;Hermes session_id is required&#10;identity arguments are not accepted; Hermes runtime session_id is used instead&#10;timeout is not accepted by orch_dispatch; configured default_timeout applies.&#10;orchestra dispatch failed&#10;orchestra dispatch did not return a run_id&#10;orchestra dispatch ack failed&#10;ORCHESTRA_DISPATCH_BUDGET dispatch budget exhausted&#10;model concurrency limit exceeded: ...&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="700" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="watch" value="&lt;b&gt;Watcher/delivery/progress errors&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;orchestra auto-return watcher failed: {message}&#10;orchestra auto-return reinjection failed: {message}&#10;Orchestra report delivery failed: {message}&#10;orchestra await-run failed.&#10;failed to format Orchestra progress message.&#10;orchestra progress notification failed: {message}&#10;timed out waiting for session report&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="700" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Worker result errors&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;Worker timed out&#10;Worker exceeded timeout&#10;Worker exited successfully without a meaningful result&#10;Worker protocol error: empty result&#10;Worker budget exceeded; redispatch from continuation handoff&#10;Worker failed&#10;Worker supervisor could not be launched&#10;Worker harness could not start&#10;Worker harness could not be loaded&#10;Worker harness is not configured&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="700" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Progress/ack/status strings&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;orchestra dispatched: {role} {run_id}&#10;subagent will auto-return when finished. Do not poll while waiting.&#10;orchestra:{role} {run_id} returned {status} ({completed}/{total})&#10;[orchestra: {role} {run_id} success|fail]&#10;[orchestra: {n} subagents returned]&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="880" y="500" width="700" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="11 Durable Return Artifact">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;return.md content vs parent-facing session report&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="artifact" value="&lt;b&gt;_format_return_output()&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;# Orchestra worker return&#10;&#10;Run: {run_id}&#10;&#10;## stdout&#10;&#10;{result.stdout or &quot;(empty)&quot;}&#10;&#10;## stderr&#10;&#10;{result.stderr if present}&lt;/pre&gt;" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="560" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Parent report points to artifact&lt;/b&gt;&lt;br/&gt;format_orchestrator_return includes:&lt;br/&gt;return_path: state/runs/{run_id}/return.md&lt;br/&gt;For failures/truncation, also includes debug/events/log/transcript paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="770" y="160" width="480" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;Parent workflow decision&lt;/b&gt;&lt;br/&gt;done hint: do not repeat work.&lt;br/&gt;incomplete hint: pass return_path into continuation dispatch.&lt;br/&gt;failed hint: read failed return artifact and decide recovery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="770" y="450" width="480" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="return_path" style="endArrow=block;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;orthogonal=1;" edge="1" parent="1" source="artifact" target="report">
