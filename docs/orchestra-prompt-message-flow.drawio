        <mxCell id="mark" value="Mark delivered / remember run ids to avoid duplicate report." style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1230" y="560" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;orthogonal=1;" edge="1" parent="1" source="wait" target="term">
