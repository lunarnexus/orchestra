  <diagram name="4 Actual Child Prompt Template">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Exact child/subagent prompt template&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;WorkerRequest fields&lt;/b&gt;&lt;br/&gt;role_name, goal, run_id, additional_context, boundaries, acceptance_target, return_format, timeout_seconds, task_label, nested_dispatch_depth, turn_limit, soft_timeout, budget_exceeded_prompt, log_path, skill_roots, prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="420" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="template" value="&lt;b&gt;render_worker_prompt() exact section labels&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;Role: {request.role_name}&#10;&#10;Goal: {request.goal.strip()}&#10;&#10;Role instructions: {role.dispatch_hint.strip()}&#10;&#10;Additional context: {request.additional_context.strip()}&#10;&#10;Out of scope: {request.boundaries.strip()}&#10;&#10;Acceptance target: {request.acceptance_target.strip()}&#10;&#10;Return format: {request.return_format.strip() or prompts.default_return_format}&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="560" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="example" value="&lt;b&gt;Example concrete child prompt shape&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;Role: reviewer&#10;&#10;Goal: Review the staged change for correctness and scope.&#10;&#10;Role instructions: You are an independent code reviewer...&#10;&#10;Additional context: PLAN.md Slice 4, tests already run: pytest -q&#10;&#10;Out of scope: Do not edit files.&#10;&#10;Acceptance target: Identify blocking defects only.&#10;&#10;Return format: Return only this compact schema unless a blocker needs more detail:&#10;Status: complete|blocked|failed&#10;Verdict: pass|fail|n/a&#10;Artifacts updated:&#10;- &lt;file or none&gt;&#10;...&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="90" width="520" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="fields" style="endArrow=block;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;orthogonal=1;" edge="1" parent="1" source="worker" target="template">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="rendered text" style="endArrow=block;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;orthogonal=1;" edge="1" parent="1" source="template" target="example">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5 Actual Return Format Prompt">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Verbatim default_return_format sent to child when caller does not override&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="default" value="&lt;b&gt;prompts.yaml default_return_format&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;Return only this compact schema unless a blocker needs more detail:&#10;Status: complete|blocked|failed&#10;Verdict: pass|fail|n/a&#10;Artifacts updated:&#10;- &lt;file or none&gt;&#10;Files changed:&#10;- &lt;file or none&gt;&#10;Commands:&#10;- &lt;exact command or none&gt; — &lt;result&gt;&#10;Evidence reused:&#10;- &lt;artifact path and exact command evidence, or none&gt;&#10;Material evidence:&#10;- &lt;one-line decisive evidence&gt;&#10;Blockers:&#10;- none|&lt;blocker&gt;&#10;Risks:&#10;- none|&lt;risk&gt;&#10;Next:&#10;- &lt;next dispatch/action&gt;&#10;&#10;Keep returns short. Put durable detail in the assigned artifact, not in the&#10;chat return. Omit empty fields. Do not include broad tables, history narratives,&#10;or lists of every file read unless material to a blocker or finding.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="90" width="760" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;parse_child_return() reads these labels&lt;/b&gt;&lt;br/&gt;Status, Verdict, Blocker, Blockers, Material evidence.&lt;br/&gt;&lt;br/&gt;It creates summary via compact_summary(limit=280), verdict from Verdict or Status, blocker from Blocker(s) or Material evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="930" y="160" width="500" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="effect" value="&lt;b&gt;Classification impact&lt;/b&gt;&lt;br/&gt;A well-formed compact return makes result_summary non-empty. Missing meaningful output after exit 0 becomes failed with protocol error." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="930" y="480" width="500" height="160" as="geometry"/>
        </mxCell>
