<?xml version="1.0" ?>
<mxfile host="app.diagrams.net" modified="2026-09-10T20:00:00.000Z" agent="pi" version="24.7.17" type="device">
  <diagram name="1 Prompt Text Inventory">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Actual prompt/message text inventory and builders&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pyaml" value="&lt;b&gt;prompts.yaml owns plain text&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;default_return_format&#10;tool_description&#10;tool_goal_description&#10;tool_additional_context_description&#10;tool_role_description&#10;tool_task_label_description&#10;main_session_ownership_guidance&#10;status_*_description&#10;return_hint_done / incomplete / failed / builder_failed&#10;budget_exceeded_prompt&#10;host_help&#10;session_mode_off_message / on_message&lt;/pre&gt;" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;PromptConfig&lt;/b&gt;&lt;br/&gt;src/orchestra/config.py&lt;br/&gt;Required prompt strings are loaded into AppConfig. Missing/non-string prompt keys are ConfigError." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="toolinfo" value="&lt;b&gt;tool_info_payload()&lt;/b&gt;&lt;br/&gt;src/orchestra/host_commands.py&lt;br/&gt;description = tool_description.format(roles) + workflow + main_session_ownership_guidance.&lt;br/&gt;Also ships argument descriptions and status/help text to host adapters." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="890" y="110" width="390" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="child" value="&lt;b&gt;render_worker_prompt()&lt;/b&gt;&lt;br/&gt;src/orchestra/harnesses/common.py&lt;br/&gt;Builds child plain-text prompt from WorkerRequest + RoleConfig dispatch_hint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="890" y="430" width="390" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="return" value="&lt;b&gt;format_orchestrator_return()&lt;/b&gt;&lt;br/&gt;src/orchestra/reports.py&lt;br/&gt;Builds parent re-entry report with summary, next hint, return_path, and failure debug fields." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1340" y="290" width="360" height="190" as="geometry"/>
