        <mxCell id="siderr" value="Error text examples:&#10;Pi/OpenCode: context.sessionID is required for orch_dispatch.&#10;Hermes: Hermes session_id is required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
