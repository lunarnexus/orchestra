        </mxCell>
        <mxCell id="marker" value="stdout has line exactly&#10;ORCHESTRA_STATUS: incomplete ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="250" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="incomp" value="status = incomplete&#10;error_text = None&#10;blocker = parsed blocker or budget exceeded handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1070" y="250" width="370" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="summary" value="meaningful summary exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="empty" value="status = failed&#10;error_text = &quot;Worker exited successfully without a meaningful result&quot;&#10;blocker = &quot;Worker protocol error: empty result&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1070" y="400" width="430" height="130" as="geometry"/>
