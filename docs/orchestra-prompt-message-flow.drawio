  <diagram name="7 Actual Budget Handoff Prompt">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Budget/turn/soft-timeout prompt injected into child session&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="env" value="&lt;b&gt;worker_subprocess_env()&lt;/b&gt;&lt;br/&gt;Sets ORCHESTRA_TURN_BUDGET, ORCHESTRA_SOFT_TIMEOUT_SECONDS, and ORCHESTRA_BUDGET_EXCEEDED_PROMPT when limits apply." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="prompt" value="&lt;b&gt;budget_exceeded_prompt verbatim&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;[Orchestra subagent budget exceeded]&#10;Stop everything you're doing immediately.&#10;&#10;Your only task now, is to create a handoff for the next agent,&#10;do not continue any previous work.&#10;&#10;Start with:&#10;&#10;ORCHESTRA_STATUS: incomplete&#10;ORCHESTRA_STOP_REASON: budget_exceeded&#10;&#10;Then return the normal compact result schema as a continuation handoff:&#10;&#10;Status: incomplete&#10;Verdict: n/a&#10;Artifacts updated:&#10;- &lt;file or none&gt;&#10;Files changed:&#10;- &lt;file or none&gt;&#10;Commands:&#10;- &lt;exact command or none&gt; — &lt;result&gt;&#10;Evidence reused:&#10;- &lt;artifact path and exact command evidence, or none&gt;&#10;Material evidence:&#10;- &lt;completed work, current state, and data locations&gt;&#10;Blockers:&#10;- none|&lt;blocker&gt;&#10;Risks:&#10;- none|&lt;risk&gt;&#10;Next:&#10;- &lt;small continuation dispatch, including remaining work and stop condition&gt;&#10;&#10;Preserve completed work and make the handoff sufficient for the caller to pass&#10;this return artifact directly to the continuation dispatch.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="720" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="inject" value="&lt;b&gt;Host injection behavior&lt;/b&gt;&lt;br/&gt;Pi: pi.sendUserMessage(prompt + &quot;Budget trigger: reason&quot;, deliverAs=&quot;steer&quot;) on turn_end/tool_call.&lt;br/&gt;Hermes: ctx.inject_message(message, role=&quot;user&quot;) or pre_llm context fallback.&lt;br/&gt;Soft timeout tool calls can be blocked with: &quot;Orchestra soft timeout reached; return budget handoff&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1340" y="160" width="390" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="env var" style="endArrow=block;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;orthogonal=1;" edge="1" parent="1" source="env" target="prompt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="reason appended" style="endArrow=block;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;orthogonal=1;" edge="1" parent="1" source="prompt" target="inject">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="8 Actual Parent Return Reports">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Plain-text report that re-enters parent session&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="single" value="&lt;b&gt;Single run success report template&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;[orchestra: {role} {run_id} success]&#10;summary: {_format_run_summary(run)}&#10;tokens: input=... output=... reasoning=... cache_read=... cache_write=... cost_usd=...&#10;next: advance the plan using this subagent return; do not repeat its work&#10;return_path: {state_dir}/runs/{run_id}/return.md&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="760" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="fail" value="&lt;b&gt;Failure / semantic failure report adds details&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;[orchestra: {role} {run_id} fail]&#10;summary: ...&#10;auto_verify: Verifier dispatch failed: ...&#10;next: read the failed return artifact and decide how to proceed&#10;return_path: .../return.md&#10;verdict: {semantic_failure}&#10;status: failed|incomplete|cancelled&#10;run_id: {run_id}&#10;debug: orchestra debug --run-id {run_id}&#10;events_path: .../events.jsonl&#10;worker_session: orchestra-worker-{run_id}&#10;transcript: &lt;path&gt;&#10;log: &lt;log_path&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="760" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="multi" value="&lt;b&gt;Multi-run wrapper&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;[orchestra: {len(runs)} subagents returned]&#10;&#10;&lt;block for run 1&gt;&#10;&#10;&lt;block for run 2&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="940" y="110" width="520" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="hints" value="&lt;b&gt;Configured next: hints&lt;/b&gt;&lt;br/&gt;&lt;pre style=&quot;font-size:11px&quot;&gt;done: advance the plan using this subagent return; do not repeat its work&#10;incomplete: pass this return_path handoff artifact to the next dispatch and continue from it&#10;failed: read the failed return artifact and decide how to proceed&#10;builder_failed: pass this return_path handoff artifact to one bounded fix-only builder follow-up&lt;/pre&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="940" y="350" width="650" height="260" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="9 Auto Return Delivery Tree">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
