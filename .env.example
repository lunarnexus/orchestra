# Orchestra uses YAML files for application configuration. Global Pi defaults live under
# ${PI_CODING_AGENT_DIR:-~/.pi/agent}/orchestra/. This file is for optional local-only
# environment variables and secrets that should never be committed.

# Example: local Pi agent directory if your Pi installation expects it.
# PI_CODING_AGENT_DIR=/absolute/path/to/.pi/agent
# Internal: numeric worker nesting level; set automatically by Orchestra harnesses.
# ORCHESTRA_WORKER=1
# ORCHESTRA_CONFIG=/absolute/path/to/config.yaml
# ORCHESTRA_AGENT_CATALOG=/absolute/path/to/agent-catalog.yaml

# Add machine-specific credentials or tokens only when a concrete integration
# requires them.
# EXAMPLE_API_TOKEN=
